// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`Scheduler bundle includes anomaly detection and AWS recommended static alarms 1`] = `
{
  "Parameters": {
    "BootstrapVersion": {
      "Default": "/cdk-bootstrap/hnb659fds/version",
      "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]",
      "Type": "AWS::SSM::Parameter::Value<String>",
    },
  },
  "Resources": {
    "AlarmsInvocationAttemptCountAnomalyAlarmB10A34DB": {
      "Properties": {
        "AlarmDescription": "Detects unexpected changes in Scheduler invocation-attempt volume. Check schedule configuration, retries, and upstream provisioning.",
        "AlarmName": "test-group - InvocationAttemptCountAnomaly",
        "ComparisonOperator": "LessThanLowerOrGreaterThanUpperThreshold",
        "DatapointsToAlarm": 3,
        "EvaluationPeriods": 4,
        "Metrics": [
          {
            "Expression": "ANOMALY_DETECTION_BAND(m0, 8)",
            "Id": "expr_1",
            "Label": "Anomaly Detection Band",
            "ReturnData": true,
          },
          {
            "Id": "m0",
            "MetricStat": {
              "Metric": {
                "Dimensions": [
                  {
                    "Name": "ScheduleGroup",
                    "Value": "test-group",
                  },
                ],
                "MetricName": "InvocationAttemptCount",
                "Namespace": "AWS/Scheduler",
              },
              "Period": 300,
              "Stat": "Sum",
            },
            "ReturnData": true,
          },
        ],
        "ThresholdMetricId": "expr_1",
        "TreatMissingData": "missing",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "AlarmsInvocationDroppedCountAlarm624944BD": {
      "Properties": {
        "AlarmDescription": "Detects invocations dropped by EventBridge Scheduler. Investigate the target and schedule retry policy.",
        "AlarmName": "test-group - InvocationDroppedCount",
        "ComparisonOperator": "GreaterThanThreshold",
        "DatapointsToAlarm": 1,
        "Dimensions": [
          {
            "Name": "ScheduleGroup",
            "Value": "test-group",
          },
        ],
        "EvaluationPeriods": 1,
        "MetricName": "InvocationDroppedCount",
        "Namespace": "AWS/Scheduler",
        "Period": 60,
        "Statistic": "Sum",
        "Threshold": 0,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "AlarmsInvocationThrottleCountAlarm66C8B8F0": {
      "Properties": {
        "AlarmDescription": "Detects persistent EventBridge Scheduler invocation throttling. Review flexible time windows and invocation quotas.",
        "AlarmName": "test-group - InvocationThrottleCount",
        "ComparisonOperator": "GreaterThanThreshold",
        "DatapointsToAlarm": 15,
        "Dimensions": [
          {
            "Name": "ScheduleGroup",
            "Value": "test-group",
          },
        ],
        "EvaluationPeriods": 15,
        "MetricName": "InvocationThrottleCount",
        "Namespace": "AWS/Scheduler",
        "Period": 60,
        "Statistic": "Sum",
        "Threshold": 0,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "AlarmsInvocationsFailedToBeSentToDeadLetterCountAlarm3A2EA5D7": {
      "Properties": {
        "AlarmDescription": "Detects EventBridge Scheduler failures to retain invocations in a dead-letter queue. Check queue permissions and availability.",
        "AlarmName": "test-group - InvocationsFailedToBeSentToDeadLetterCount",
        "ComparisonOperator": "GreaterThanThreshold",
        "DatapointsToAlarm": 15,
        "Dimensions": [
          {
            "Name": "ScheduleGroup",
            "Value": "test-group",
          },
        ],
        "EvaluationPeriods": 15,
        "MetricName": "InvocationsFailedToBeSentToDeadLetterCount",
        "Namespace": "AWS/Scheduler",
        "Period": 60,
        "Statistic": "Sum",
        "Threshold": 0,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "AlarmsTargetErrorThrottledCountAlarm5A57A933": {
      "Properties": {
        "AlarmDescription": "Detects persistent throttling by Scheduler targets. Spread invocations with flexible time windows or increase target capacity.",
        "AlarmName": "test-group - TargetErrorThrottledCount",
        "ComparisonOperator": "GreaterThanThreshold",
        "DatapointsToAlarm": 15,
        "Dimensions": [
          {
            "Name": "ScheduleGroup",
            "Value": "test-group",
          },
        ],
        "EvaluationPeriods": 15,
        "MetricName": "TargetErrorThrottledCount",
        "Namespace": "AWS/Scheduler",
        "Period": 60,
        "Statistic": "Sum",
        "Threshold": 0,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "GroupC77FDACD": {
      "DeletionPolicy": "Retain",
      "Properties": {
        "Name": "test-group",
      },
      "Type": "AWS::Scheduler::ScheduleGroup",
      "UpdateReplacePolicy": "Retain",
    },
  },
  "Rules": {
    "CheckBootstrapVersion": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Contains": [
                  [
                    "1",
                    "2",
                    "3",
                    "4",
                    "5",
                  ],
                  {
                    "Ref": "BootstrapVersion",
                  },
                ],
              },
            ],
          },
          "AssertDescription": "CDK bootstrap stack version 6 required. Please run 'cdk bootstrap' with a recent version of the CDK CLI.",
        },
      ],
    },
  },
}
`;

