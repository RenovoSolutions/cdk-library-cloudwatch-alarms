        "MetricName": "TunnelState",
        "Namespace": "AWS/VPN",
        "Period": 300,
        "Statistic": "Minimum",
        "Threshold": 1,
        "TreatMissingData": "missing",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
