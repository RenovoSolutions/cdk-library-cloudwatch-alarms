              " - CPUUtilization",
            ],
          ],
        },
        "ComparisonOperator": "GreaterThanThreshold",
        "DatapointsToAlarm": 5,
        "Dimensions": [
          {
            "Name": "ClusterName",
            "Value": {
              "Ref": "ClusterEB0386A7",
            },
          },
          {
            "Name": "ServiceName",
            "Value": {
              "Fn::GetAtt": [
                "ServiceD69D759B",
                "Name",
              ],
            },
          },
        ],
        "EvaluationPeriods": 5,
        "InsufficientDataActions": [
          {
            "Fn::GetAtt": [
              "LambdaD247545B",
              "Arn",
            ],
          },
        ],
        "MetricName": "CPUUtilization",
        "Namespace": "AWS/ECS",
        "OKActions": [
          {
            "Fn::GetAtt": [
              "LambdaD247545B",
              "Arn",
            ],
          },
        ],
        "Period": 60,
        "Statistic": "Average",
        "Threshold": 90,
        "TreatMissingData": "missing",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
