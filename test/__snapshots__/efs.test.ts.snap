exports[`SnapshotForEfsFileSystemConstruct 1`] = `
{
  "Parameters": {
    "BootstrapVersion": {
      "Default": "/cdk-bootstrap/hnb659fds/version",
      "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]",
      "Type": "AWS::SSM::Parameter::Value<String>",
    },
  },
  "Resources": {
    "FileSystem8A8E25C0": {
      "DeletionPolicy": "Retain",
      "Properties": {
        "Encrypted": true,
        "FileSystemTags": [
          {
            "Key": "Name",
            "Value": "TestStack/FileSystem",
          },
        ],
      },
      "Type": "AWS::EFS::FileSystem",
      "UpdateReplacePolicy": "Retain",
    },
    "FileSystemEfsFileSystemRecommendedAlarmsFileSystemBurstCreditBalance034F211E": {
      "Properties": {
        "AlarmDescription": "This alarm is used to detect low burst credit balance of the file system. Consistent low burst credit balance can be an indicator of the slowing down in throughput and increase in I/O latency.",
        "AlarmName": {
          "Fn::Join": [
            "",
            [
              {
                "Ref": "FileSystem8A8E25C0",
              },
              " - BurstCreditBalance",
            ],
          ],
        },
        "ComparisonOperator": "LessThanOrEqualToThreshold",
        "DatapointsToAlarm": 15,
        "Dimensions": [
          {
            "Name": "FileSystemId",
            "Value": {
              "Ref": "FileSystem8A8E25C0",
            },
          },
        ],
        "EvaluationPeriods": 15,
        "MetricName": "BurstCreditBalance",
        "Namespace": "AWS/EFS",
        "Period": 60,
        "Statistic": "Average",
        "Tags": [
          {
            "Key": "Name",
            "Value": "TestStack/FileSystem",
          },
        ],
        "Threshold": 0,
        "TreatMissingData": "missing",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "FileSystemEfsFileSystemRecommendedAlarmsFileSystemPercentIOLimit2301B2B8": {
      "Properties": {
        "AlarmDescription": "This alarm is used to detect how close the file system is to reach the I/O limit of the General Purpose performance mode. Consistent high I/O percentage can be an indicator of the file system cannot scale with respect to I/O requests enough and the file system can be a resource bottleneck for the applications that use the file system.",
        "AlarmName": {
          "Fn::Join": [
            "",
            [
              {
                "Ref": "FileSystem8A8E25C0",
              },
              " - PercentIOLimit",
            ],
          ],
        },
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "DatapointsToAlarm": 15,
        "Dimensions": [
          {
            "Name": "FileSystemId",
            "Value": {
              "Ref": "FileSystem8A8E25C0",
            },
          },
        ],
        "EvaluationPeriods": 15,
        "MetricName": "PercentIOLimit",
        "Namespace": "AWS/EFS",
        "Period": 60,
        "Statistic": "Average",
        "Tags": [
          {
            "Key": "Name",
            "Value": "TestStack/FileSystem",
          },
        ],
        "Threshold": 100,
        "TreatMissingData": "missing",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
