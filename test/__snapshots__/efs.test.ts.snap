        "MetricName": "PercentIOLimit",
        "Namespace": "AWS/EFS",
        "Period": 60,
        "Statistic": "Average",
        "Tags": [
          {
            "Key": "Name",
            "Value": "TestStack/FileSystem",
          },
        ],
        "Threshold": 100,
