    },
  },
  "Rules": {
    "CheckBootstrapVersion": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Contains": [
                  [
                    "1",
                    "2",
                    "3",
                    "4",
                    "5",
                  ],
                  {
                    "Ref": "BootstrapVersion",
                  },
                ],
              },
            ],
          },
          "AssertDescription": "CDK bootstrap stack version 6 required. Please run 'cdk bootstrap' with a recent version of the CDK CLI.",
        },
      ],
    },
  },
}
`;

exports[`optional Cluster alarm configurations can be overwritten 1`] = `
{
  "Parameters": {
    "BootstrapVersion": {
      "Default": "/cdk-bootstrap/hnb659fds/version",
      "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]",
      "Type": "AWS::SSM::Parameter::Value<String>",
    },
  },
  "Resources": {
    "RedisCluster": {
      "Properties": {
        "CacheNodeType": "cache.t3.micro",
        "CacheSubnetGroupName": {
          "Ref": "RedisSubnetGroup",
        },
        "ClusterName": "my-redis-cluster",
        "Engine": "redis",
        "NumCacheNodes": 3,
        "VpcSecurityGroupIds": [
          {
            "Fn::GetAtt": [
              "VPCB9E5F0B4",
              "DefaultSecurityGroup",
            ],
          },
        ],
      },
      "Type": "AWS::ElastiCache::CacheCluster",
    },
    "RedisClusterElastiCacheClusterRecommendedAlarmsFromAspectRedisClusterDatabaseMemoryUsagePercentage4C8F0900": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "TopicBFC7AF6E",
          },
        ],
        "AlarmDescription": "Custom alarm description",
        "AlarmName": "CustomDatabaseMemoryUsagePercentageAlarm",
        "ComparisonOperator": "GreaterThanThreshold",
        "DatapointsToAlarm": 25,
        "Dimensions": [
          {
            "Name": "CacheClusterId",
            "Value": "my-redis-cluster",
          },
        ],
        "EvaluationPeriods": 25,
        "InsufficientDataActions": [
          {
            "Ref": "TopicBFC7AF6E",
          },
        ],
        "MetricName": "DatabaseMemoryUsagePercentage",
        "Namespace": "AWS/ElastiCache",
        "OKActions": [
          {
            "Ref": "TopicBFC7AF6E",
          },
        ],
        "Period": 300,
        "Statistic": "Average",
        "Threshold": 10,
        "TreatMissingData": "ignore",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "RedisClusterElastiCacheClusterRecommendedAlarmsFromAspectRedisClusterEngineCPUUtilization0A455F66": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "TopicBFC7AF6E",
          },
        ],
        "AlarmDescription": "Custom alarm description",
        "AlarmName": "CustomEngineCpuUtilizationAlarm",
        "ComparisonOperator": "GreaterThanThreshold",
        "DatapointsToAlarm": 25,
        "Dimensions": [
          {
            "Name": "CacheClusterId",
            "Value": "my-redis-cluster",
          },
        ],
        "EvaluationPeriods": 25,
        "InsufficientDataActions": [
          {
            "Ref": "TopicBFC7AF6E",
          },
        ],
        "MetricName": "EngineCPUUtilization",
        "Namespace": "AWS/ElastiCache",
        "OKActions": [
          {
            "Ref": "TopicBFC7AF6E",
          },
        ],
        "Period": 300,
        "Statistic": "Average",
        "Threshold": 10,
        "TreatMissingData": "ignore",
      },
