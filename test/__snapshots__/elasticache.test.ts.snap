    },
  },
  "Resources": {
    "RedisCluster1": {
      "Properties": {
        "CacheNodeType": "cache.t3.micro",
        "CacheSubnetGroupName": {
          "Ref": "RedisSubnetGroup1",
        },
        "ClusterName": "my-redis-cluster",
        "Engine": "redis",
        "NumCacheNodes": 3,
        "VpcSecurityGroupIds": [
          {
            "Fn::GetAtt": [
              "VPCB9E5F0B4",
              "DefaultSecurityGroup",
            ],
          },
        ],
      },
