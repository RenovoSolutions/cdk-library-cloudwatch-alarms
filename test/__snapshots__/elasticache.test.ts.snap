      "Properties": {
        "AlarmActions": [
          {
            "Fn::GetAtt": [
              "LambdaD247545B",
              "Arn",
            ],
          },
        ],
        "AlarmDescription": "This alarm is used to detect high memory utilization of your cluster so that you can avoid failures when writing to your cluster. It is useful to know when you will need to scale up your cluster if your application does not expect to experience evictions.",
        "AlarmName": "my-redis-cluster - DatabaseMemoryUsagePercentage",
        "ComparisonOperator": "GreaterThanThreshold",
        "DatapointsToAlarm": 5,
        "Dimensions": [
          {
            "Name": "CacheClusterId",
            "Value": "my-redis-cluster",
          },
        ],
        "EvaluationPeriods": 5,
        "InsufficientDataActions": [
          {
            "Fn::GetAtt": [
              "LambdaD247545B",
              "Arn",
            ],
          },
        ],
        "MetricName": "DatabaseMemoryUsagePercentage",
        "Namespace": "AWS/ElastiCache",
        "OKActions": [
          {
            "Fn::GetAtt": [
              "LambdaD247545B",
              "Arn",
            ],
          },
        ],
        "Period": 60,
        "Statistic": "Average",
        "Threshold": 90,
        "TreatMissingData": "missing",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "elasticacheCfnCacheClusterAlarmsRedisClusterEngineCPUUtilization71395816": {
      "Properties": {
        "AlarmActions": [
