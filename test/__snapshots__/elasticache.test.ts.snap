`;

exports[`stack should contain cacheCluster recommended alarms if recommended alarms aspect is applied with no exclusions 1`] = `
{
  "Parameters": {
    "BootstrapVersion": {
      "Default": "/cdk-bootstrap/hnb659fds/version",
      "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]",
      "Type": "AWS::SSM::Parameter::Value<String>",
    },
  },
  "Resources": {
    "RedisCluster": {
      "Properties": {
        "CacheNodeType": "cache.t3.micro",
        "CacheSubnetGroupName": {
          "Ref": "RedisSubnetGroup",
        },
        "ClusterName": "my-redis-cluster",
        "Engine": "redis",
        "NumCacheNodes": 3,
        "VpcSecurityGroupIds": [
          {
            "Fn::GetAtt": [
              "VPCB9E5F0B4",
              "DefaultSecurityGroup",
            ],
          },
        ],
      },
      "Type": "AWS::ElastiCache::CacheCluster",
    },
    "RedisClusterElastiCacheClusterRecommendedAlarmsFromAspectRedisClusterDatabaseMemoryUsagePercentage4C8F0900": {
      "Properties": {
        "AlarmDescription": "This alarm is used to detect high memory utilization of your cluster so that you can avoid failures when writing to your cluster. It is useful to know when you will need to scale up your cluster if your application does not expect to experience evictions.",
        "AlarmName": "my-redis-cluster - DatabaseMemoryUsagePercentage",
        "ComparisonOperator": "GreaterThanThreshold",
        "DatapointsToAlarm": 5,
        "Dimensions": [
          {
            "Name": "CacheClusterId",
            "Value": "my-redis-cluster",
          },
        ],
        "EvaluationPeriods": 5,
        "MetricName": "DatabaseMemoryUsagePercentage",
        "Namespace": "AWS/ElastiCache",
        "Period": 60,
        "Statistic": "Average",
        "Threshold": 90,
        "TreatMissingData": "missing",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "RedisClusterElastiCacheClusterRecommendedAlarmsFromAspectRedisClusterEngineCPUUtilization0A455F66": {
      "Properties": {
        "AlarmDescription": "This alarm is used to detect high CPU utilization of the Redis OSS engine thread. It is useful if you want to monitor the CPU usage of the database engine itself.",
        "AlarmName": "my-redis-cluster - EngineCPUUtilization",
        "ComparisonOperator": "GreaterThanThreshold",
        "DatapointsToAlarm": 5,
        "Dimensions": [
          {
            "Name": "CacheClusterId",
            "Value": "my-redis-cluster",
          },
        ],
        "EvaluationPeriods": 5,
        "MetricName": "EngineCPUUtilization",
        "Namespace": "AWS/ElastiCache",
        "Period": 60,
        "Statistic": "Average",
        "Threshold": 90,
        "TreatMissingData": "missing",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "RedisClusterElastiCacheClusterRecommendedAlarmsFromAspectRedisClusterReplicationLag9C5A0E17": {
      "Properties": {
        "AlarmDescription": "This alarm is used to detect a delay between data updates on the primary node and their synchronization to replica node. It helps to ensure data consistency of a read replica cluster node.",
        "AlarmName": "my-redis-cluster - ReplicationLag",
        "ComparisonOperator": "GreaterThanThreshold",
        "DatapointsToAlarm": 15,
        "Dimensions": [
          {
            "Name": "CacheClusterId",
            "Value": "my-redis-cluster",
          },
        ],
        "EvaluationPeriods": 15,
        "MetricName": "ReplicationLag",
        "Namespace": "AWS/ElastiCache",
        "Period": 60,
        "Statistic": "Average",
        "Threshold": 90,
        "TreatMissingData": "missing",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "RedisSubnetGroup": {
      "Properties": {
        "Description": "Subnet group for Redis cluster",
        "SubnetIds": [
          {
            "Ref": "VPCPrivateSubnet1Subnet8BCA10E0",
          },
          {
            "Ref": "VPCPrivateSubnet2SubnetCFCDAA7A",
          },
          {
            "Ref": "VPCPrivateSubnet3Subnet3EDCD457",
          },
        ],
      },
      "Type": "AWS::ElastiCache::SubnetGroup",
    },
    "VPCB9E5F0B4": {
      "Properties": {
        "CidrBlock": "10.0.0.0/16",
        "EnableDnsHostnames": true,
        "EnableDnsSupport": true,
        "InstanceTenancy": "default",
        "Tags": [
          {
            "Key": "Name",
            "Value": "TestStack/VPC",
          },
        ],
      },
      "Type": "AWS::EC2::VPC",
    },
    "VPCIGWB7E252D3": {
      "Properties": {
        "Tags": [
          {
            "Key": "Name",
            "Value": "TestStack/VPC",
          },
        ],
      },
      "Type": "AWS::EC2::InternetGateway",
    },
    "VPCPrivateSubnet1DefaultRouteAE1D6490": {
