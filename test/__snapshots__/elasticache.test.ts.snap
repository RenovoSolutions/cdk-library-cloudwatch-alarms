          "Fn::GetAtt": [
            "LambdaD247545B",
            "Arn",
          ],
        },
        "Principal": "lambda.alarms.cloudwatch.amazonaws.com",
        "SourceAccount": "123456789012",
        "SourceArn": {
          "Fn::GetAtt": [
            "elasticacheCfnCacheClusterAlarmsRedisClusterDatabaseMemoryUsagePercentage7B3ECC3B",
