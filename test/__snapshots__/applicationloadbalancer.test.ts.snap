            "ReturnData": true,
          },
        ],
        "OKActions": [
          {
            "Ref": "TopicBFC7AF6E",
          },
        ],
        "ThresholdMetricId": "expr_1",
        "TreatMissingData": "missing",
      },
      "Type": "AWS::CloudWatch::Alarm",
