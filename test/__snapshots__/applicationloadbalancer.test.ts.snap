          "Fn::Join": [
            "",
            [
              {
                "Fn::GetAtt": [
                  "ALB27057A3AE",
                  "LoadBalancerName",
                ],
              },
              " - HTTPCode_Target_5XX_Count",
            ],
          ],
        },
        "ComparisonOperator": "GreaterThanThreshold",
        "DatapointsToAlarm": 3,
        "Dimensions": [
          {
            "Name": "LoadBalancer",
            "Value": {
              "Fn::GetAtt": [
                "ALB27057A3AE",
                "LoadBalancerFullName",
              ],
            },
          },
        ],
        "EvaluationPeriods": 3,
        "MetricName": "HTTPCode_Target_5XX_Count",
        "Namespace": "AWS/ApplicationELB",
        "Period": 60,
        "Statistic": "Sum",
        "Threshold": 0,
        "TreatMissingData": "missing",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "ALB2ApplicationLoadBalancerRecommendedAlarmsFromAspectALB2RejectedConnectionCount4DD6B6D7": {
      "Properties": {
        "AlarmDescription": "This alarm is used to detect when the load balancer is rejecting connections. Rejected connections can indicate that the load balancer has reached its maximum connection limit.",
        "AlarmName": {
          "Fn::Join": [
