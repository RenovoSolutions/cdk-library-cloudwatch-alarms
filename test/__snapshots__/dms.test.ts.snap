exports[`when an resource is excluded from the aspect config it should not have alarms 2`] = `
{
  "Parameters": {
    "BootstrapVersion": {
      "Default": "/cdk-bootstrap/hnb659fds/version",
      "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]",
      "Type": "AWS::SSM::Parameter::Value<String>",
    },
  },
  "Resources": {
    "ReplicationTask1": {
      "Properties": {
        "MigrationType": "full-load-and-cdc",
        "ReplicationInstanceArn": "arn:aws:dms:us-east-1:123456789012:rep:replication-instance",
        "ReplicationTaskIdentifier": "testReplicationTask1",
        "SourceEndpointArn": "arn:aws:dms:us-east-1:123456789012:endpoint:source-endpoint",
        "TableMappings": "{"rules":[{"rule-type":"selection","rule-id":"1","rule-name":"1","object-locator":{"schema-name":"%","table-name":"%"},"rule-action":"include"}]}",
        "TargetEndpointArn": "arn:aws:dms:us-east-1:123456789012:endpoint:target-endpoint",
      },
      "Type": "AWS::DMS::ReplicationTask",
    },
    "ReplicationTask2": {
      "Properties": {
        "MigrationType": "full-load-and-cdc",
        "ReplicationInstanceArn": "arn:aws:dms:us-east-1:123456789012:rep:replication-instance",
        "ReplicationTaskIdentifier": "testReplicationTask2",
        "SourceEndpointArn": "arn:aws:dms:us-east-1:123456789012:endpoint:source-endpoint",
        "TableMappings": "{"rules":[{"rule-type":"selection","rule-id":"1","rule-name":"1","object-locator":{"schema-name":"%","table-name":"%"},"rule-action":"include"}]}",
        "TargetEndpointArn": "arn:aws:dms:us-east-1:123456789012:endpoint:target-endpoint",
      },
      "Type": "AWS::DMS::ReplicationTask",
    },
    "ReplicationTask2DmsReplicationTaskRecommendedAlarmsFromAspecttestReplicationTask2CdcThroughputRowsSourceCE78BCC3": {
      "Properties": {
        "AlarmDescription": "This alarm monitors CDC throughput from the source database. High values may indicate unexpected data changes or bulk operations. Low values may indicate replication lag or source database issues.",
        "AlarmName": "testReplicationTask2 - CDCThroughputRowsSource",
        "ComparisonOperator": "GreaterThanThreshold",
        "DatapointsToAlarm": 2,
        "Dimensions": [
          {
            "Name": "ReplicationInstanceIdentifier",
            "Value": "arn:aws:dms:us-east-1:123456789012:rep:replication-instance",
          },
          {
            "Name": "ReplicationTaskIdentifier",
            "Value": "testReplicationTask2",
          },
        ],
        "EvaluationPeriods": 3,
        "MetricName": "CDCThroughputRowsSource",
        "Namespace": "AWS/DMS",
        "Period": 300,
        "Statistic": "Average",
        "Threshold": 100,
        "TreatMissingData": "missing",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "ReplicationTask2DmsReplicationTaskRecommendedAlarmsFromAspecttestReplicationTask2CdcThroughputRowsTarget074DF3D1": {
      "Properties": {
        "AlarmDescription": "This alarm monitors CDC throughput to the target database. High values may indicate unexpected data changes or bulk operations. Low values may indicate replication lag or target database issues.",
        "AlarmName": "testReplicationTask2 - CDCThroughputRowsTarget",
        "ComparisonOperator": "GreaterThanThreshold",
        "DatapointsToAlarm": 2,
        "Dimensions": [
          {
            "Name": "ReplicationInstanceIdentifier",
            "Value": "arn:aws:dms:us-east-1:123456789012:rep:replication-instance",
          },
          {
            "Name": "ReplicationTaskIdentifier",
            "Value": "testReplicationTask2",
          },
        ],
        "EvaluationPeriods": 3,
        "MetricName": "CDCThroughputRowsTarget",
        "Namespace": "AWS/DMS",
        "Period": 300,
        "Statistic": "Average",
        "Threshold": 100,
        "TreatMissingData": "missing",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "ReplicationTask2DmsReplicationTaskRecommendedAlarmsFromAspecttestReplicationTask2FullLoadThroughputRowsSource7B235801": {
      "Properties": {
        "AlarmDescription": "This alarm monitors full load throughput from the source database. Low values may indicate performance issues or full load completion. Zero values indicate full load has completed or stalled.",
        "AlarmName": "testReplicationTask2 - FullLoadThroughputRowsSource",
        "ComparisonOperator": "LessThanThreshold",
        "DatapointsToAlarm": 2,
        "Dimensions": [
          {
            "Name": "ReplicationInstanceIdentifier",
            "Value": "arn:aws:dms:us-east-1:123456789012:rep:replication-instance",
          },
          {
            "Name": "ReplicationTaskIdentifier",
            "Value": "testReplicationTask2",
          },
        ],
        "EvaluationPeriods": 3,
        "MetricName": "FullLoadThroughputRowsSource",
        "Namespace": "AWS/DMS",
        "Period": 300,
        "Statistic": "Average",
        "Threshold": 1000,
        "TreatMissingData": "missing",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "ReplicationTask2DmsReplicationTaskRecommendedAlarmsFromAspecttestReplicationTask2FullLoadThroughputRowsTarget2CA13986": {
      "Properties": {
        "AlarmDescription": "This alarm monitors full load throughput to the target database. Low values may indicate performance issues or full load completion. Zero values indicate full load has completed or stalled.",
        "AlarmName": "testReplicationTask2 - FullLoadThroughputRowsTarget",
        "ComparisonOperator": "LessThanThreshold",
        "DatapointsToAlarm": 2,
        "Dimensions": [
          {
            "Name": "ReplicationInstanceIdentifier",
            "Value": "arn:aws:dms:us-east-1:123456789012:rep:replication-instance",
          },
          {
            "Name": "ReplicationTaskIdentifier",
