exports[`stack should contain replicationInstance recommended alarms if recommended alarms aspect is applied with no exclusions 1`] = `
{
  "Parameters": {
    "BootstrapVersion": {
      "Default": "/cdk-bootstrap/hnb659fds/version",
      "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]",
      "Type": "AWS::SSM::Parameter::Value<String>",
    },
  },
  "Resources": {
    "ReplicationInstance": {
      "Properties": {
        "ReplicationInstanceClass": "dms.t3.medium",
        "ReplicationInstanceIdentifier": "testReplicationInstance",
        "VpcSecurityGroupIds": [
          {
            "Fn::GetAtt": [
              "testSG462E28D9",
              "GroupId",
            ],
          },
        ],
      },
      "Type": "AWS::DMS::ReplicationInstance",
    },
    "ReplicationInstanceDmsReplicationInstanceRecommendedAlarmsFromAspecttestReplicationInstanceCpuUtilizationCAE7690E": {
      "Properties": {
        "AlarmDescription": "This alarm is used to detect high CPU utilization for the DMS Replication Instance. Consistent high CPU utilization can indicate a resource bottleneck or application performance problems.",
        "AlarmName": "testReplicationInstance - CPUUtilization",
        "ComparisonOperator": "GreaterThanThreshold",
        "DatapointsToAlarm": 5,
        "Dimensions": [
          {
            "Name": "ReplicationInstanceIdentifier",
            "Value": "testReplicationInstance",
          },
        ],
        "EvaluationPeriods": 5,
        "MetricName": "CPUUtilization",
        "Namespace": "AWS/DMS",
        "Period": 60,
        "Statistic": "Average",
        "Threshold": 90,
        "TreatMissingData": "missing",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "ReplicationInstanceDmsReplicationInstanceRecommendedAlarmsFromAspecttestReplicationInstanceFreeStorageSpace2B565645": {
