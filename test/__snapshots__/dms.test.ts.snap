exports[`alarms can be applied individually to replicationInstances using extended construct 1`] = `
{
  "Parameters": {
    "BootstrapVersion": {
      "Default": "/cdk-bootstrap/hnb659fds/version",
      "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]",
      "Type": "AWS::SSM::Parameter::Value<String>",
    },
  },
  "Resources": {
    "ReplicationInstance": {
      "Properties": {
        "ReplicationInstanceClass": "dms.t3.medium",
        "ReplicationInstanceIdentifier": "testReplicationInstance",
        "VpcSecurityGroupIds": [
          {
            "Fn::GetAtt": [
              "testSG462E28D9",
              "GroupId",
            ],
          },
        ],
      },
      "Type": "AWS::DMS::ReplicationInstance",
    },
    "ReplicationInstanceCpuUtilizationAlarmDC3BEECD": {
      "Properties": {
        "AlarmDescription": "This alarm is used to detect high CPU utilization for the DMS Replication Instance. Consistent high CPU utilization can indicate a resource bottleneck or application performance problems.",
        "AlarmName": "testReplicationInstance - CPUUtilization",
        "ComparisonOperator": "GreaterThanThreshold",
        "DatapointsToAlarm": 5,
        "Dimensions": [
          {
            "Name": "ReplicationInstanceIdentifier",
            "Value": "testReplicationInstance",
          },
        ],
        "EvaluationPeriods": 5,
        "MetricName": "CPUUtilization",
        "Namespace": "AWS/DMS",
        "Period": 60,
        "Statistic": "Average",
        "Threshold": 90,
        "TreatMissingData": "missing",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "ReplicationInstanceFreeStorageSpaceAlarm074292E8": {
      "Properties": {
        "AlarmDescription": "This alarm helps prevent storage full issues. This can prevent downtime that occurs when your replication instance runs out of storage.",
        "AlarmName": "testReplicationInstance - FreeStorageSpace",
        "ComparisonOperator": "LessThanOrEqualToThreshold",
        "DatapointsToAlarm": 5,
        "Dimensions": [
          {
            "Name": "ReplicationInstanceIdentifier",
            "Value": "testReplicationInstance",
          },
        ],
        "EvaluationPeriods": 5,
        "MetricName": "FreeStorageSpace",
        "Namespace": "AWS/DMS",
        "Period": 60,
        "Statistic": "Average",
        "Threshold": 25000,
        "TreatMissingData": "missing",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "ReplicationInstanceFreeableMemoryAlarmC7B71EAC": {
      "Properties": {
        "AlarmDescription": "This alarm is used to help prevent running out of memory.",
        "AlarmName": "testReplicationInstance - FreeableMemory",
        "ComparisonOperator": "LessThanOrEqualToThreshold",
        "DatapointsToAlarm": 5,
        "Dimensions": [
          {
            "Name": "DBInstanceIdentifier",
            "Value": "testReplicationInstance",
          },
        ],
        "EvaluationPeriods": 5,
        "MetricName": "FreeableMemory",
        "Namespace": "AWS/DMS",
        "Period": 60,
        "Statistic": "Average",
        "Threshold": 25000,
        "TreatMissingData": "missing",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "ReplicationInstanceWriteIopsAlarm7532D216": {
      "Properties": {
        "AlarmDescription": "This alarm is used to detect high write IOPS for the DMS Replication Instance. High write IOPS can indicate heavy write activity or potential I/O bottlenecks.",
        "AlarmName": "testReplicationInstance - WriteIOPS",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "DatapointsToAlarm": 5,
        "Dimensions": [
          {
            "Name": "ReplicationInstanceIdentifier",
            "Value": "testReplicationInstance",
          },
        ],
        "EvaluationPeriods": 5,
        "MetricName": "WriteIOPS",
        "Namespace": "AWS/DMS",
        "Period": 60,
        "Statistic": "Average",
        "Threshold": 1000,
        "TreatMissingData": "missing",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "VPCB9E5F0B4": {
      "Properties": {
        "CidrBlock": "10.0.0.0/16",
        "EnableDnsHostnames": true,
        "EnableDnsSupport": true,
        "InstanceTenancy": "default",
        "Tags": [
          {
            "Key": "Name",
            "Value": "TestStack/VPC",
          },
        ],
      },
      "Type": "AWS::EC2::VPC",
    },
    "VPCIGWB7E252D3": {
      "Properties": {
        "Tags": [
          {
