exports[`alarms can be applied individually to replicationTasks using extended construct 1`] = `
{
  "Parameters": {
    "BootstrapVersion": {
      "Default": "/cdk-bootstrap/hnb659fds/version",
      "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]",
      "Type": "AWS::SSM::Parameter::Value<String>",
    },
  },
  "Resources": {
    "ReplicationInstance": {
      "Properties": {
        "ReplicationInstanceClass": "dms.t3.medium",
        "ReplicationInstanceIdentifier": "testReplicationInstance",
        "VpcSecurityGroupIds": [
          {
            "Fn::GetAtt": [
              "testSG462E28D9",
              "GroupId",
            ],
          },
        ],
      },
      "Type": "AWS::DMS::ReplicationInstance",
    },
    "ReplicationTask": {
      "Properties": {
        "MigrationType": "full-load-and-cdc",
        "ReplicationInstanceArn": {
          "Ref": "ReplicationInstance",
        },
        "ReplicationTaskIdentifier": "testReplicationTask",
        "SourceEndpointArn": {
          "Ref": "SourceEndpoint",
        },
        "TableMappings": "{"rules":[{"rule-type":"selection","rule-id":"1","rule-name":"1","object-locator":{"schema-name":"%","table-name":"%"},"rule-action":"include"}]}",
        "TargetEndpointArn": {
          "Ref": "TargetEndpoint",
        },
      },
      "Type": "AWS::DMS::ReplicationTask",
    },
    "ReplicationTaskCdcThroughputRowsSourceAlarm318B5553": {
      "Properties": {
        "AlarmDescription": "This alarm monitors CDC throughput from the source database. High values may indicate unexpected data changes or bulk operations. Low values may indicate replication lag or source database issues.",
        "AlarmName": "testReplicationTask - CDCThroughputRowsSource",
        "ComparisonOperator": "GreaterThanThreshold",
        "DatapointsToAlarm": 2,
        "Dimensions": [
          {
            "Name": "ReplicationInstanceIdentifier",
            "Value": {
              "Ref": "ReplicationInstance",
            },
          },
          {
            "Name": "ReplicationTaskIdentifier",
            "Value": "testReplicationTask",
          },
        ],
        "EvaluationPeriods": 3,
        "MetricName": "CDCThroughputRowsSource",
        "Namespace": "AWS/DMS",
        "Period": 300,
        "Statistic": "Average",
        "Threshold": 1000,
        "TreatMissingData": "missing",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "ReplicationTaskCdcThroughputRowsTargetAlarmE8067FF3": {
      "Properties": {
        "AlarmDescription": "This alarm monitors CDC throughput to the target database. High values may indicate unexpected data changes or bulk operations. Low values may indicate replication lag or target database issues.",
        "AlarmName": "testReplicationTask - CDCThroughputRowsTarget",
        "ComparisonOperator": "GreaterThanThreshold",
        "DatapointsToAlarm": 2,
        "Dimensions": [
          {
            "Name": "ReplicationInstanceIdentifier",
            "Value": {
              "Ref": "ReplicationInstance",
            },
          },
          {
            "Name": "ReplicationTaskIdentifier",
            "Value": "testReplicationTask",
          },
        ],
        "EvaluationPeriods": 3,
        "MetricName": "CDCThroughputRowsTarget",
        "Namespace": "AWS/DMS",
        "Period": 300,
        "Statistic": "Average",
        "Threshold": 100,
        "TreatMissingData": "missing",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "ReplicationTaskFullLoadThroughputRowsSourceAlarm21C481DD": {
      "Properties": {
        "AlarmDescription": "This alarm monitors full load throughput from the source database. Low values may indicate performance issues or full load completion. Zero values indicate full load has completed or stalled.",
        "AlarmName": "testReplicationTask - FullLoadThroughputRowsSource",
        "ComparisonOperator": "LessThanThreshold",
        "DatapointsToAlarm": 2,
        "Dimensions": [
          {
            "Name": "ReplicationInstanceIdentifier",
            "Value": {
              "Ref": "ReplicationInstance",
            },
          },
          {
            "Name": "ReplicationTaskIdentifier",
            "Value": "testReplicationTask",
          },
        ],
        "EvaluationPeriods": 3,
        "MetricName": "FullLoadThroughputRowsSource",
        "Namespace": "AWS/DMS",
        "Period": 300,
        "Statistic": "Average",
        "Threshold": 1000,
        "TreatMissingData": "missing",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "ReplicationTaskFullLoadThroughputRowsTargetAlarm608697D5": {
      "Properties": {
        "AlarmDescription": "This alarm monitors full load throughput to the target database. Low values may indicate performance issues or full load completion. Zero values indicate full load has completed or stalled.",
        "AlarmName": "testReplicationTask - FullLoadThroughputRowsTarget",
        "ComparisonOperator": "LessThanThreshold",
        "DatapointsToAlarm": 2,
        "Dimensions": [
          {
            "Name": "ReplicationInstanceIdentifier",
            "Value": {
              "Ref": "ReplicationInstance",
            },
          },
          {
            "Name": "ReplicationTaskIdentifier",
            "Value": "testReplicationTask",
          },
        ],
        "EvaluationPeriods": 3,
        "MetricName": "FullLoadThroughputRowsTarget",
        "Namespace": "AWS/DMS",
        "Period": 300,
        "Statistic": "Average",
        "Threshold": 1000,
        "TreatMissingData": "missing",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "SourceEndpoint": {
      "Properties": {
        "DatabaseName": "sourcedb",
        "EndpointType": "source",
        "EngineName": "mysql",
        "Password": "password",
        "Port": 3306,
        "ServerName": "source.example.com",
        "Username": "admin",
      },
      "Type": "AWS::DMS::Endpoint",
    },
    "TargetEndpoint": {
