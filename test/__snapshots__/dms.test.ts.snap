exports[`when an resource is excluded from the aspect config it should not have alarms 1`] = `
{
  "Parameters": {
    "BootstrapVersion": {
      "Default": "/cdk-bootstrap/hnb659fds/version",
      "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]",
      "Type": "AWS::SSM::Parameter::Value<String>",
    },
  },
  "Resources": {
    "ReplicationInstance1": {
      "Properties": {
        "ReplicationInstanceClass": "dms.t3.medium",
        "ReplicationInstanceIdentifier": "testReplicationInstance1",
        "VpcSecurityGroupIds": [
          {
            "Fn::GetAtt": [
              "testSG462E28D9",
              "GroupId",
            ],
          },
        ],
      },
      "Type": "AWS::DMS::ReplicationInstance",
    },
    "ReplicationInstance2": {
      "Properties": {
        "ReplicationInstanceClass": "dms.t3.medium",
        "ReplicationInstanceIdentifier": "testReplicationInstance2",
        "VpcSecurityGroupIds": [
          {
            "Fn::GetAtt": [
              "testSG462E28D9",
              "GroupId",
            ],
          },
        ],
      },
      "Type": "AWS::DMS::ReplicationInstance",
    },
    "ReplicationInstance2DmsReplicationInstanceRecommendedAlarmsFromAspecttestReplicationInstance2CpuUtilizationABC9E6FC": {
      "Properties": {
        "AlarmDescription": "This alarm is used to detect high CPU utilization for the DMS Replication Instance. Consistent high CPU utilization can indicate a resource bottleneck or application performance problems.",
        "AlarmName": "testReplicationInstance2 - CPUUtilization",
        "ComparisonOperator": "GreaterThanThreshold",
        "DatapointsToAlarm": 5,
        "Dimensions": [
          {
            "Name": "ReplicationInstanceIdentifier",
            "Value": "testReplicationInstance2",
          },
        ],
        "EvaluationPeriods": 5,
        "MetricName": "CPUUtilization",
        "Namespace": "AWS/DMS",
        "Period": 60,
        "Statistic": "Average",
        "Threshold": 90,
        "TreatMissingData": "missing",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "ReplicationInstance2DmsReplicationInstanceRecommendedAlarmsFromAspecttestReplicationInstance2FreeStorageSpace885D0F6D": {
      "Properties": {
        "AlarmDescription": "This alarm helps prevent storage full issues. This can prevent downtime that occurs when your replication instance runs out of storage.",
        "AlarmName": "testReplicationInstance2 - FreeStorageSpace",
        "ComparisonOperator": "LessThanOrEqualToThreshold",
        "DatapointsToAlarm": 5,
        "Dimensions": [
          {
            "Name": "ReplicationInstanceIdentifier",
            "Value": "testReplicationInstance2",
          },
        ],
        "EvaluationPeriods": 5,
        "MetricName": "FreeStorageSpace",
        "Namespace": "AWS/DMS",
        "Period": 60,
        "Statistic": "Average",
        "Threshold": 25000,
        "TreatMissingData": "missing",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "ReplicationInstance2DmsReplicationInstanceRecommendedAlarmsFromAspecttestReplicationInstance2FreeableMemoryFA520365": {
