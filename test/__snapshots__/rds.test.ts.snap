            },
          },
        ],
        "EvaluationPeriods": 2,
        "MetricName": "AuroraVolumeBytesLeftTotal",
        "Namespace": "AWS/RDS",
        "Period": 60,
        "Statistic": "Average",
        "Threshold": 20,
